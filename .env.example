# convoTalk configuration. Copy to .env.local and fill in. Never commit .env.local.
#   cp .env.example .env.local
#
# Leave a section blank and the app degrades honestly:
#   - no Supabase vars  -> clearly labeled DEMO MODE (nothing syncs between browsers)
#   - no GEMINI_API_KEY -> messages sync, but translation is off (original text only)

# --- Supabase Realtime (browser-side, safe to expose: it's the public key) ---
# Supabase dashboard -> Project Settings -> API
# 1. Project URL, e.g. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# 2. The "anon" public key (or the newer "publishable" key). NEVER use the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Translation (server-side only; do NOT prefix with NEXT_PUBLIC_) ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
